{
  "name": "@moneio/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Background job processor - document ingestion pipeline",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate --schema=../../packages/db/prisma/schema.prisma && tsc && esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/index.cjs --external:@prisma/client --external:sharp",
    "start": "node dist/index.cjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@moneio/ai": "workspace:*",
    "@moneio/core-ledger": "workspace:*",
    "@moneio/db": "workspace:*",
    "@moneio/domain": "workspace:*",
    "@moneio/observability": "workspace:*",
    "@moneio/utils": "workspace:*",
    "@prisma/client": "^5.22.0",
    "@google-cloud/vision": "^4.2.0",
    "@supabase/supabase-js": "^2.43.0",
    "@upstash/redis": "^1.31.0",
    "bullmq": "^5.7.0",
    "ioredis": "^5.4.0",
    "openai": "^4.47.0",
    "pdf-lib": "^1.17.1",
    "pino": "^9.0.0",
    "sharp": "^0.33.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "esbuild": "^0.21.0",
    "pino-pretty": "^11.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.10.0",
    "typescript": "^5.3.0",
    "vitest": "^1.6.0"
  }
}
