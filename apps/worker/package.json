{
  "name": "@moneio/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Background job processor - document ingestion pipeline",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && esbuild src/index.ts --bundle --platform=node --outfile=dist/index.js --external:postgres --external:sharp",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google-cloud/vision": "^4.0.0",
    "@moneio/ai": "workspace:*",
    "@moneio/core-ledger": "workspace:*",
    "@moneio/db": "workspace:*",
    "@moneio/domain": "workspace:*",
    "@supabase/supabase-js": "^2.39.0",
    "bullmq": "^5.0.0",
    "ioredis": "^5.3.0",
    "openai": "^4.20.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "esbuild": "^0.19.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
