# ===========================================
# Moneio Worker Service Environment Variables
# ===========================================

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Supabase Service Role (for storage access and admin operations)
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"

# Upstash Redis (BullMQ Queue)
UPSTASH_REDIS_REST_URL="https://[REGION]-[ID].upstash.io"
UPSTASH_REDIS_REST_TOKEN="[TOKEN]"

# Google Cloud Vision OCR
GOOGLE_CLOUD_PROJECT_ID="[PROJECT_ID]"
GOOGLE_CLOUD_CREDENTIALS="[PATH_TO_SERVICE_ACCOUNT_JSON or JSON_STRING]"

# OpenAI API Key (for extraction and categorization)
OPENAI_API_KEY="sk-..."

# FX Rates API (for currency conversion)
FX_RATES_API_URL="https://api.exchangerate-api.com/v4/latest"
FX_RATES_API_KEY=""

# Sentry Error Tracking
SENTRY_DSN=""

# Worker Config
WORKER_CONCURRENCY="5"
WORKER_MAX_RETRIES="3"
LOG_LEVEL="info"
