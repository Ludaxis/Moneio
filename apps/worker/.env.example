# ===========================================
# Moneio Worker Service Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# -------------------------------------------
# SUPABASE (Required)
# Get these from: https://supabase.com/dashboard/project/_/settings/api
# -------------------------------------------

# Database connection string (Settings → Database → Connection string → URI)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Supabase Project URL (Settings → API → Project URL)
SUPABASE_URL="https://[PROJECT_REF].supabase.co"

# Supabase Service Role Key (Settings → API → service_role secret)
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# -------------------------------------------
# UPSTASH REDIS (Required)
# Get these from: https://console.upstash.com/redis
# -------------------------------------------

# Redis connection URL (use redis:// URL, NOT the REST URL)
# Format: rediss://default:[PASSWORD]@[ENDPOINT]:6379
REDIS_URL="rediss://default:xxx@xxx.upstash.io:6379"

# Alternative variable name (either works)
# UPSTASH_REDIS_URL="rediss://default:xxx@xxx.upstash.io:6379"

# -------------------------------------------
# OPENAI (Required for AI extraction/categorization)
# Get from: https://platform.openai.com/api-keys
# -------------------------------------------

OPENAI_API_KEY="sk-..."

# -------------------------------------------
# GOOGLE CLOUD VISION (Required for OCR)
# Get from: https://console.cloud.google.com
# 1. Enable Cloud Vision API
# 2. Create Service Account with Vision API access
# 3. Download JSON key file
# -------------------------------------------

# Your GCP Project ID
GOOGLE_CLOUD_PROJECT_ID="your-project-id"

# Path to service account JSON file OR the JSON content as a string
# Option 1: File path
GOOGLE_CLOUD_CREDENTIALS="/path/to/service-account.json"
# Option 2: JSON string (for deployment platforms)
# GOOGLE_CLOUD_CREDENTIALS='{"type":"service_account","project_id":"..."}'

# -------------------------------------------
# CURRENCY EXCHANGE RATES (Optional)
# Free tier available at: https://www.exchangerate-api.com
# -------------------------------------------

FX_RATES_API_URL="https://api.exchangerate-api.com/v4/latest"
FX_RATES_API_KEY=""

# -------------------------------------------
# WORKER CONFIG (Optional)
# -------------------------------------------

# Number of concurrent jobs to process
WORKER_CONCURRENCY="5"

# Maximum retry attempts for failed jobs
WORKER_MAX_RETRIES="3"

# Log level: debug, info, warn, error
LOG_LEVEL="info"

# -------------------------------------------
# ERROR TRACKING - SENTRY (Optional)
# Get from: https://sentry.io
# -------------------------------------------

SENTRY_DSN=""

# -------------------------------------------
# ALERTING (Optional)
# Configure to receive alerts for job failures
# -------------------------------------------

# Slack webhook for alerts
# Create at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=""

# Custom webhook URL for alerts (receives JSON POST)
ALERT_WEBHOOK_URL=""

# Number of consecutive failures before alerting (default: 5)
ALERT_CONSECUTIVE_FAILURES="5"

# Error rate percentage threshold for warnings (default: 20)
ALERT_ERROR_RATE_THRESHOLD="20"
