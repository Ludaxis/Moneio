# ===========================================
# Moneio Web Application Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# cp .env.example .env.local

# -------------------------------------------
# SUPABASE (Required)
# Get these from: https://supabase.com/dashboard/project/_/settings/api
# -------------------------------------------

# Database connection string (Settings → Database → Connection string → URI)
# Use Supabase pooler for serverless (port 6543) with pgbouncer + connection_limit=1
DATABASE_URL="postgresql://postgres:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Direct connection for migrations only (NO pgbouncer)
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Supabase Project URL (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"

# Supabase Anon/Public Key (Settings → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# Optional server-only alias (recommended for server-side code)
# If set, keep the value identical to NEXT_PUBLIC_SUPABASE_URL
SUPABASE_URL="https://[PROJECT_REF].supabase.co"

# Supabase Service Role Key (Settings → API → service_role secret)
# WARNING: Never expose this to the client/browser
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# -------------------------------------------
# UPSTASH REDIS (Required for background jobs)
# Get these from: https://console.upstash.com/redis
# -------------------------------------------

# Redis connection URL (use redis:// URL, NOT the REST URL)
# Format: rediss://default:[PASSWORD]@[ENDPOINT]:6379
REDIS_URL="rediss://default:xxx@xxx.upstash.io:6379"

# -------------------------------------------
# AI PROVIDERS (At least one required for AI features)
# Prefers Gemini if both are set
# -------------------------------------------

# Google Gemini API Key (Recommended - free tier available)
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=""

# Alternative: OpenAI API Key
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# -------------------------------------------
# ELEVENLABS (Optional - for voice assistant)
# Get from: https://elevenlabs.io/app/settings/api-keys
# Agent ID from: https://elevenlabs.io/app/conversational-ai
# -------------------------------------------

ELEVENLABS_API_KEY=""

# ElevenLabs Conversational AI Agent ID (for real-time voice assistant)
# Create an agent at https://elevenlabs.io/app/conversational-ai and copy the ID
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=""

# -------------------------------------------
# APPLICATION CONFIG (Optional)
# -------------------------------------------

# Your production URL (used for auth callbacks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Default locale (en, et, fa, ar)
NEXT_PUBLIC_DEFAULT_LOCALE="en"

# -------------------------------------------
# PLAID (Optional - for bank connections)
# Get from: https://dashboard.plaid.com/developers/keys
# -------------------------------------------

# Plaid Client ID (found in Plaid Dashboard → Developers → Keys)
PLAID_CLIENT_ID=""

# Plaid Secret (use sandbox/development/production secret based on environment)
PLAID_SECRET=""

# Plaid Environment: sandbox, development, or production
# Start with sandbox for testing, then move to development, then production
PLAID_ENV="sandbox"

# -------------------------------------------
# ERROR TRACKING - SENTRY (Optional)
# Get from: https://sentry.io
# -------------------------------------------

NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
