{
  "name": "@moneio/mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "MCP Server for Moneio financial data",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/http-server.ts",
    "dev:stdio": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/http-server.js",
    "start:stdio": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@moneio/db": "workspace:*",
    "express": "^4.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
