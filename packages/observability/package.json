{
  "name": "@moneio/observability",
  "version": "0.1.0",
  "private": true,
  "description": "Datadog LLM Observability - tracing, monitoring, and alerting for AI operations",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./llm": "./src/llm/index.ts",
    "./detection": "./src/detection/index.ts",
    "./dashboard": "./src/dashboard/index.ts",
    "./alerts": "./src/alerts/index.ts",
    "./integrations": "./src/integrations/index.ts",
    "./integrations/worker": "./src/integrations/worker.ts",
    "./integrations/nextjs": "./src/integrations/nextjs.ts"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@moneio/ai": "workspace:*",
    "@moneio/core-ledger": "workspace:*",
    "dd-trace": "^5.0.0",
    "pino": "^9.0.0"
  },
  "peerDependencies": {
    "bullmq": "^5.0.0",
    "next": "^14.0.0"
  },
  "peerDependenciesMeta": {
    "bullmq": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "bullmq": "^5.7.0",
    "next": "^14.2.0",
    "typescript": "^5.3.0",
    "vitest": "^1.6.0"
  }
}
