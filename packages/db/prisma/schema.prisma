// Moneio Database Schema
// Prisma with Supabase PostgreSQL

generator client {
  provider = "prisma-client-js"
  // Include serverless-friendly target for Vercel (rhel-openssl-3.0.x) alongside native for local dev
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// Core Tables - Users and Workspaces
// ============================================================

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String?
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspaceMembers WorkspaceMember[]
  auditLogs        AuditLog[]

  @@map("users")
}

model Workspace {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  baseCurrency String   @default("EUR") @map("base_currency") @db.VarChar(3)
  locale       String   @default("en") @db.VarChar(5)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  members                  WorkspaceMember[]
  documents                Document[]
  merchants                Merchant[]
  invoices                 Invoice[]
  bankAccounts             BankAccount[]
  bankTransactions         BankTransaction[]
  categories               Category[]
  transactionCategorizations TransactionCategorization[]
  rules                    Rule[]
  matches                  Match[]
  aiSuggestions            AiSuggestion[]
  auditLogs                AuditLog[]
  fxRates                  FxRate[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  role        String   @default("member") @db.VarChar(20) // owner, admin, member
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

// ============================================================
// Document Processing Tables
// ============================================================

enum DocumentStatus {
  uploaded
  processing
  ocr_complete
  extracting
  ready
  failed

  @@map("document_status")
}

enum DocumentType {
  invoice
  receipt
  bank_statement
  other

  @@map("document_type")
}

model Document {
  id          String         @id @default(uuid()) @db.Uuid
  workspaceId String         @map("workspace_id") @db.Uuid
  status      DocumentStatus @default(uploaded)
  docType     DocumentType?  @map("doc_type")
  fileName    String         @map("file_name")
  mimeType    String         @map("mime_type")
  fileSize    Int            @map("file_size")
  pageCount   Int?           @map("page_count")
  failReason  String?        @map("fail_reason")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  blobs        DocumentBlob[]
  ocrArtifacts OcrArtifact[]
  extractions  Extraction[]
  invoices     Invoice[]

  @@index([workspaceId, createdAt])
  @@index([workspaceId, status])
  @@map("documents")
}

model DocumentBlob {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  storagePath String  @map("storage_path")
  blobType   String   @map("blob_type") @db.VarChar(50) // original, normalized, thumbnail
  createdAt  DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_blobs")
}

model OcrArtifact {
  id          String   @id @default(uuid()) @db.Uuid
  documentId  String   @map("document_id") @db.Uuid
  pageNumber  Int      @map("page_number")
  payloadJson Json     @map("payload_json")
  createdAt   DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, pageNumber])
  @@map("ocr_artifacts")
}

model Extraction {
  id          String   @id @default(uuid()) @db.Uuid
  documentId  String   @map("document_id") @db.Uuid
  version     Int      @default(1)
  payloadJson Json     @map("payload_json")
  approved    Boolean  @default(false)
  approvedAt  DateTime? @map("approved_at")
  approvedBy  String?   @map("approved_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("extractions")
}

// ============================================================
// Financial Tables
// ============================================================

model Merchant {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  name            String
  normalizedName  String   @map("normalized_name")
  vatNumber       String?  @map("vat_number")
  country         String?  @db.VarChar(2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoices  Invoice[]

  @@unique([workspaceId, normalizedName])
  @@map("merchants")
}

model Invoice {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  documentId      String?   @map("document_id") @db.Uuid
  merchantId      String?   @map("merchant_id") @db.Uuid
  invoiceNumber   String?   @map("invoice_number")
  issueDate       DateTime? @map("issue_date") @db.Date
  dueDate         DateTime? @map("due_date") @db.Date
  currency        String    @default("EUR") @db.VarChar(3)
  subtotal        Decimal   @default(0) @db.Decimal(15, 2)
  vatAmount       Decimal   @default(0) @map("vat_amount") @db.Decimal(15, 2)
  total           Decimal   @default(0) @db.Decimal(15, 2)
  vatRate         Decimal?  @map("vat_rate") @db.Decimal(5, 2)
  vatEvidence     Json?     @map("vat_evidence") // Links to source text/bbox
  status          String    @default("pending") @db.VarChar(20) // pending, approved, paid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document   Document?          @relation(fields: [documentId], references: [id], onDelete: SetNull)
  merchant   Merchant?          @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  lineItems  InvoiceLineItem[]
  matches    Match[]

  @@index([workspaceId, issueDate])
  @@map("invoices")
}

model InvoiceLineItem {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @map("invoice_id") @db.Uuid
  description String?
  quantity    Decimal @default(1) @db.Decimal(10, 4)
  unitPrice   Decimal @default(0) @map("unit_price") @db.Decimal(15, 2)
  amount      Decimal @default(0) @db.Decimal(15, 2)
  vatRate     Decimal? @map("vat_rate") @db.Decimal(5, 2)
  sortOrder   Int      @default(0) @map("sort_order")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_line_items")
}

model BankAccount {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String
  accountNumber String? @map("account_number")
  iban        String?
  currency    String   @default("EUR") @db.VarChar(3)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions BankTransaction[]

  @@map("bank_accounts")
}

model BankTransaction {
  id            String    @id @default(uuid()) @db.Uuid
  workspaceId   String    @map("workspace_id") @db.Uuid
  bankAccountId String    @map("bank_account_id") @db.Uuid
  txHash        String    @map("tx_hash") // For idempotent imports
  postedAt      DateTime  @map("posted_at") @db.Date
  description   String?
  amount        Decimal   @db.Decimal(15, 2)
  currency      String    @default("EUR") @db.VarChar(3)
  balance       Decimal?  @db.Decimal(15, 2)
  rawData       Json?     @map("raw_data")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  workspace     Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  bankAccount   BankAccount                 @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  categorizations TransactionCategorization[]
  matches       Match[]

  @@unique([workspaceId, txHash])
  @@index([workspaceId, postedAt])
  @@map("bank_transactions")
}

// ============================================================
// Categorization Tables
// ============================================================

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String
  parentId    String?  @map("parent_id") @db.Uuid
  taxCode     String?  @map("tax_code") @db.VarChar(20)
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace       Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent          Category?                   @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children        Category[]                  @relation("CategoryHierarchy")
  categorizations TransactionCategorization[]
  rules           Rule[]

  @@unique([workspaceId, name])
  @@map("categories")
}

model TransactionCategorization {
  id            String   @id @default(uuid()) @db.Uuid
  workspaceId   String   @map("workspace_id") @db.Uuid
  transactionId String   @map("transaction_id") @db.Uuid
  categoryId    String   @map("category_id") @db.Uuid
  confidence    Decimal? @db.Decimal(5, 4)
  source        String   @default("manual") @db.VarChar(20) // manual, ai, rule
  approved      Boolean  @default(false)
  approvedAt    DateTime? @map("approved_at")
  approvedBy    String?   @map("approved_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transaction BankTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  category    Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([transactionId, categoryId])
  @@map("transaction_categorizations")
}

model Rule {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  name        String
  conditions  Json     // Pattern matching conditions
  priority    Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("rules")
}

// ============================================================
// Matching Tables
// ============================================================

model Match {
  id            String   @id @default(uuid()) @db.Uuid
  workspaceId   String   @map("workspace_id") @db.Uuid
  invoiceId     String   @map("invoice_id") @db.Uuid
  transactionId String   @map("transaction_id") @db.Uuid
  confidence    Decimal? @db.Decimal(5, 4)
  rationale     String?
  status        String   @default("suggested") @db.VarChar(20) // suggested, approved, rejected
  approvedAt    DateTime? @map("approved_at")
  approvedBy    String?   @map("approved_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoice     Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  transaction BankTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, transactionId])
  @@map("matches")
}

// ============================================================
// AI Tables
// ============================================================

enum SuggestionType {
  extraction
  categorization
  match

  @@map("suggestion_type")
}

model AiSuggestion {
  id           String         @id @default(uuid()) @db.Uuid
  workspaceId  String         @map("workspace_id") @db.Uuid
  suggestionType SuggestionType @map("suggestion_type")
  targetId     String         @map("target_id") @db.Uuid
  payloadJson  Json           @map("payload_json")
  confidence   Decimal?       @db.Decimal(5, 4)
  status       String         @default("pending") @db.VarChar(20) // pending, accepted, rejected
  createdAt    DateTime       @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, suggestionType, status])
  @@map("ai_suggestions")
}

// ============================================================
// Audit & FX Tables
// ============================================================

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  action      String   @db.VarChar(50)
  entityType  String   @map("entity_type") @db.VarChar(50)
  entityId    String   @map("entity_id") @db.Uuid
  oldValue    Json?    @map("old_value")
  newValue    Json?    @map("new_value")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_log")
}

model FxRate {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  baseCurrency String   @map("base_currency") @db.VarChar(3)
  quoteCurrency String  @map("quote_currency") @db.VarChar(3)
  rate         Decimal  @db.Decimal(20, 10)
  effectiveDate DateTime @map("effective_date") @db.Date
  source       String   @default("api") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, baseCurrency, quoteCurrency, effectiveDate])
  @@index([workspaceId, effectiveDate])
  @@map("fx_rates")
}
