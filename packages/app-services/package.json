{
  "name": "@moneio/app-services",
  "version": "0.1.0",
  "private": true,
  "description": "Application services layer - tenant context, API wrappers, and business logic",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./shared": "./src/shared/index.ts",
    "./transactions": "./src/transactions/index.ts",
    "./dashboard": "./src/dashboard/index.ts",
    "./documents": "./src/documents/index.ts",
    "./voice": "./src/voice/index.ts",
    "./reports": "./src/reports/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@moneio/core-ledger": "workspace:*",
    "@moneio/domain": "workspace:*",
    "@moneio/db": "workspace:*",
    "@supabase/ssr": "^0.3.0",
    "@supabase/supabase-js": "^2.43.0",
    "@upstash/ratelimit": "^2.0.0",
    "@upstash/redis": "^1.34.0",
    "zod": "^3.22.0"
  },
  "peerDependencies": {
    "next": "^14.0.0",
    "react": "^18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "typescript": "^5.3.0",
    "vitest": "^1.6.0"
  }
}
