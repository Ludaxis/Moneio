{
  "name": "@moneio/domain",
  "version": "0.1.0",
  "private": true,
  "description": "Domain layer - entities, services, and business logic (can import core-ledger, not UI)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./documents": "./src/documents/index.ts",
    "./financial": "./src/financial/index.ts",
    "./categorization": "./src/categorization/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@moneio/core-ledger": "workspace:*",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "vitest": "^1.6.0"
  }
}
